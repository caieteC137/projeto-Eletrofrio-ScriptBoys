# =============================================================
#  Eletrofrio - Variaveis de ambiente (modelo, SEM segredos reais)
# =============================================================
# Copie este arquivo para `.env` e preencha os valores reais.
#   cp .env.example .env
# NUNCA commite o .env real no git (ele ja esta no .gitignore).
# -------------------------------------------------------------

# ---- Aplicacao ----
TZ=America/Sao_Paulo

# ---- Supabase (externo) ----
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_KEY=sua_chave_supabase_aqui

# ---- Google Gemini ----
GEMINI_API_KEY=sua_chave_gemini_aqui

# ---- Evolution API (gateway WhatsApp) ----
# URL interna quando rodando em Docker na mesma stack:
EVOLUTION_URL=http://evolution:8080
# Para acessar de fora da VM (ex.: Evolution Manager pelo navegador):
# EVOLUTION_URL=http://<IP_PUBLICO_DA_VM>:8080
EVOLUTION_API_KEY=troque-esta-chave-em-producao
EVOLUTION_INSTANCE=55SEUNUMEROCOMDDD
EVOLUTION_HOST_PORT=8080
EVOLUTION_LOG_LEVEL=ERROR,WARN,INFO

# ---- PostgreSQL da Evolution (compartilhado entre Evolution e bot_polling) ----
EVOLUTION_DB_HOST=postgres
EVOLUTION_DB_PORT=5432
EVOLUTION_DB_NAME=evolution
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-esta-senha-em-producao
POSTGRES_DB=evolution
REDIS_PASSWORD=troque-esta-senha-em-producao

# ---- Bot de chat (polling) ----
POLL_INTERVAL=5
BOT_SESSION_TIMEOUT=1800
# Idade maxima (em segundos) das mensagens que o bot responde.
# Mensagens mais antigas que isso sao IGNORADAS (evita responder backlog
# antigo apos uma queda longa do servico). Padrao: 86400 (24h).
BOT_MAX_MESSAGE_AGE_SECONDS=86400

# ---- Dashboard web (read-only, porta 5000) ----
DASHBOARD_HOST_PORT=5000
DASHBOARD_PORT=5000
DASHBOARD_DEBUG=0
