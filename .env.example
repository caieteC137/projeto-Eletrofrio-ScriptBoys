# ─────────────────────────────────────────────────────────────
# Variáveis de Ambiente - Sistema de Notificações Eletrofrio
# ─────────────────────────────────────────────────────────────
# Copie este arquivo para .env e preencha com suas credenciais

# Supabase (já existentes)
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_KEY=sua-api-key-supabase

# Evolution API - Configurações para envio de WhatsApp
# Para Evolution API LOCAL (Docker): http://localhost:8080
# Para Evolution API REMOTA: https://api.evolution.com.br/v1
EVOLUTION_URL=http://localhost:8080
EVOLUTION_API_KEY=sua-api-key-evolution
EVOLUTION_INSTANCE=seu-numero-whatsapp

# Número padrão de fallback (se unidade não tiver telefone)
DEFAULT_PHONE=5511999999999

# Configurações de Reenvio de Mensagens
# Intervalos em segundos (5min, 15min, 30min)
RETRY_INTERVALS=300,900,1800
MAX_RETRIES=3

# Configurações do Serviço de Alarmes
POLL_INTERVAL=60

# Base URL para API de Alarmes
BASE_URL=https://credenciamento.eletrofrio.com.br:5900/galileo/api/api_hackathon?route=alarmes

# Base URL para API de Telemetria
TELEMETRIA_URL=https://credenciamento.eletrofrio.com.br:5900/galileo/api/api_hackathon?route=telemetria

# Database PostgreSQL (se usar local)
DATABASE_URL=postgresql://user:password@localhost:5432/telemetria_db
